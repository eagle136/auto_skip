# ===== 构建产物 =====
.gradle/
.kotlin/
build/
app/build/
captures/
.externalNativeBuild/
.cxx/
*.iml
.idea/

# 仓库只保留 releases/ 下的正式发布件，构建出来的 APK 不入库
*.apk
*.aab
*.ap_
!releases/*.apk

# ===== 签名与密钥：绝不入库 =====
keystore.properties
keystore/
*.jks
*.keystore
*.p12

# 例外：仓库内的一次性公开签名。密钥与口令都是公开的随机值，不构成任何身份，只为让
# clone 下来的人能直接出包。真实发布走 tools/make_release.py，每次现生成新密钥。
!signing/open-release.jks

# ===== 机器相关 =====
local.properties

# ===== 本地调试残留（保留目录意义说明，内容不入库）=====
backup/
evidence_device/
ramdisk
ramdisk.tar
*.log
*.hprof

# ===== Python =====
__pycache__/
*.pyc
*.pyo
.venv/

# ===== 系统 =====
.DS_Store
Thumbs.db
desktop.ini
