# 复制为 keystore.properties 后填入自己的签名信息。
# keystore.properties 已进 .gitignore，不要提交真实口令。
#
# 自建密钥：
#   keytool -genkeypair -v -keystore keystore/release_key.jks \
#     -alias autoskip -keyalg RSA -keysize 4096 -validity 10000

storeFile=keystore/release_key.jks
storePassword=CHANGE_ME
keyAlias=autoskip
keyPassword=CHANGE_ME
